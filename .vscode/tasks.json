{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Compile C++",
            "type": "process",
            "command": "g++",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },

        {
            "label": "Build and Run C++",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "Compile C++",
            "dependsOrder": "sequence",

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}